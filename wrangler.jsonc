{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seibi-to",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "seibi-to.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["17 19 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seibi-to",
      "database_id": "67fb5adc-d6f0-42b5-8ae3-6d6c985e3581",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
